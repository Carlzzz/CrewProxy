# ═══════════════════════════════════════════════════════════════════════════════
# Claw Proxy 环境变量配置
# ═══════════════════════════════════════════════════════════════════════════════

# 代理配置文件路径（可选，默认 ./proxy-config.json）
# WOICLAW_PROXY_CONFIG=/path/to/proxy-config.json

# Verbose 日志（可选，开启后打印每个请求的详细路由和上游信息）
# WOICLAW_PROXY_VERBOSE=1

# ─── 认证方式（三选一，优先级：BYPASS > PROXY_API_KEY > 外部认证服务）──────────

# 方式 1：免认证（开发/本地调试用，跳过所有认证检查）
# WOICLAW_AUTH_BYPASS=1

# 方式 2：静态 API Key（客户端 x-api-key 必须等于此值才放行）
# WOICLAW_PROXY_API_KEY=your-proxy-secret-key

# 方式 3：外部认证服务（生产环境，对接中控平台）
# WOICLAW_AUTH_HOST=http://10.192.9.103:8088
# WOICLAW_AUTH_USER_PATH=/woicrew/api/user-by-device
#
# 认证请求方式（GET 或 POST，默认 GET）
# WOICLAW_AUTH_METHOD=GET
#
# Token 参数名（GET 时作为 query param，POST 时作为 JSON body 字段，默认 deviceId）
# WOICLAW_AUTH_TOKEN_PARAM=deviceId
#
# 响应校验：成功字段路径和期望值（支持嵌套，如 data.status）
# WOICLAW_AUTH_SUCCESS_FIELD=rc
# WOICLAW_AUTH_SUCCESS_VALUE=0
#
# 响应中用户名的字段路径（支持嵌套，如 data.user.name）
# WOICLAW_AUTH_NAME_FIELD=data.name
#
# 示例 1 — 默认格式（WoiCrew 中控）：
#   GET http://host/woicrew/api/user-by-device?deviceId=<token>
#   响应 { "rc": 0, "data": { "name": "张三" } }
#
# 示例 2 — 自定义中控：
#   WOICLAW_AUTH_HOST=http://center.example.com
#   WOICLAW_AUTH_USER_PATH=/api/v1/auth/verify
#   WOICLAW_AUTH_METHOD=POST
#   WOICLAW_AUTH_TOKEN_PARAM=token
#   WOICLAW_AUTH_SUCCESS_FIELD=code
#   WOICLAW_AUTH_SUCCESS_VALUE=200
#   WOICLAW_AUTH_NAME_FIELD=result.username

# ─── Usage 日志 ──────────────────────────────────────────────────────────────

# 日志目录（可选，默认 ./logs）
# WOICLAW_LOG_DIR=./logs

# 单文件最大字节数（可选，默认 104857600 = 100MB，最小 1MB）
# WOICLAW_USAGE_LOG_MAX_BYTES=104857600

# 为 1 时，usage 每行增加 input_fulltext（完整上游请求 JSON，体积大；默认不记）
# WOICLAW_USAGE_LOG_INPUT_FULLTEXT=1

# input_content 里 tail_preview 的最大字符数（默认 8192，至少 4096）
# WOICLAW_USAGE_LOG_TAIL_PREVIEW_MAX=8192

# ─── Elasticsearch 同步（npm run sync-usage）─────────────────────────────────

# ES 节点地址（必填，如不配置则 sync-usage 默认连 localhost:9200）
# WOICLAW_ES_NODE=http://es.example.com:9200

# ES 索引名（默认 woicrew-usage）
# WOICLAW_ES_INDEX=woicrew-usage

# 每批 bulk 写入文档数（默认 500）
# WOICLAW_ES_BULK_SIZE=500

# 循环同步间隔（毫秒，默认 600000 = 10 分钟）
# WOICLAW_ES_INTERVAL_MS=600000

# 断点状态文件目录（默认 ./data）
# USAGE_SYNC_STATE_DIR=./data

# 为 1 时只跑一次就退出（适合 cron 调度）
# RUN_ONCE=1
