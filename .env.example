# 代理配置文件路径（可选，见 README 配置说明）
# WOICLAW_PROXY_CONFIG=/path/to/proxy-config.json

# 外部认证服务（必选：认证失败会 401，不转发模型请求）
# 请求：GET {AUTH_HOST}{AUTH_USER_PATH}?deviceId=<客户端 token>，成功取 data.name 为用户名
WOICLAW_AUTH_HOST=http://10.192.9.103:8088
WOICLAW_AUTH_USER_PATH=/woicrew/api/user-by-device

# 日志目录（可选）
# WOICLAW_LOG_DIR=./logs

# Usage 日志单文件最大字节数，单位字节（可选，默认 104857600 = 100MB）
# WOICLAW_USAGE_LOG_MAX_BYTES=104857600

# 为 1 或 true 时，usage 每行增加 input_fulltext（完整上游请求 JSON，体积大；默认不记）
# WOICLAW_USAGE_LOG_INPUT_FULLTEXT=1

# input_content 里 tail_preview 的最大字符数（默认 8192，至少 4096）
# WOICLAW_USAGE_LOG_TAIL_PREVIEW_MAX=8192

# 流式时打印上游每个含 usage 的 chunk（原始 usage JSON + 解析/合并后的 cached），排查 input_cached_token 用
# WOICLAW_LOG_STREAM_USAGE_DEBUG=1
